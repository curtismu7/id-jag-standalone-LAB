{
  "info": {
    "name": "ID-JAG Standalone LAB",
    "description": "API collection for ID-JAG Standalone LAB: inspect tokens, run the playground's negative tests, and drive the live flow (issue ID-JAG by RFC 8693 exchange, redeem by RFC 7523, call the MCP server). Sign-in-gated steps need a browser sign-in session first (the pi.flow precondition folder); in Live mode the server keeps the tokens and returns decoded claims only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "be92809a-3bb9-4022-92dc-39777b977bad"
  },
  "item": [
    {
      "name": "Sanity",
      "description": "Lab liveness and backend reachability.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "const b = pm.response.json(); pm.expect(b.state).to.be.oneOf(['ready', 'needs-setup']);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
              "host": [
                "{{LAB_BASE}}"
              ],
