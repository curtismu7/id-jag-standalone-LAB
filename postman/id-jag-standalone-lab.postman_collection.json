    {
      "name": "Inspect (no sign-in needed)",
      "description": "Decode and check a pasted token. Works without a session; never sends the token anywhere except the lab's own checker.",
      "item": [
        {
          "name": "Decode a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().type).to.be.a('string');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:4720"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{SAMPLE_TOKEN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/inspect/decode",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "inspect",
                "decode"
              ]
            },
            "description": ""
          },
          "response": []
        },
