# Settings. The one file every standalone app reads is ~/Development/.env (mode 600); STANDALONE_ENV names another.
# `npm run setup -- --mode=pf-local` creates and fills it. This repo's own .env (copy of this file, git-ignored) is still
# read after it, so existing setups keep working. Real environment variables win over both. Never commit real secrets.
# Admin logins (PingFederate PF_ADMIN_USER / PF_ADMIN_PASSWORD) do NOT go in the shared file: `npm run setup` keeps the
# local PingFederate admin login only in ~/.config/demo-kit/provisioning.json (mode 600).
# Mock mode needs none of this. Unset settings make the matching real mode answer 409 not_configured,
# and the playground's pre-flight check names what to set.
#
# docker compose (deploy/docker-compose.yml) reads this file too, for every service. It sets the
# addresses the services use to find each other itself (APP_ORIGIN, RESOURCE_AS_ISSUER,
# RESOURCE_AS_TOKEN_ENDPOINT, ID_JAG_RESOURCE, MCP_URL, and PORT/DATA_DIR), so values for those
# here apply to npm runs only. Compose's host ports come from the shell:
#   HOST_PORT=4720 (playground)  AS_HOST_PORT=4721 (resource-as)  MCP_HOST_PORT=4722 (mcp-sample)

# --- Mode ---
# mock (default when the PF_* settings below are not set): everything is answered inside the app and nothing leaves this machine. live: the servers below.
# The Mock/Live switch in the header saves its choice in DATA_DIR/mode.json, which wins over this. Live can be chosen only once
# PF_URL, PF_EXCHANGE_CLIENT_ID and PF_EXCHANGE_CLIENT_SECRET are set. Also read from the shared settings file (STANDALONE_ENV, else ~/Development/.env).
# MODE=mock
# Mock sign-in (the built-in demo account) needs this, a loopback bind (HOST=127.0.0.1) and no proxy.
# ALLOW_MOCK_SIGNIN=1

# --- App (the playground server) ---
# PORT=4720
# The browser origin. Every non-GET API call must carry exactly this Origin (CSRF check).
# Local dev through Vite: APP_ORIGIN=http://localhost:4723
APP_ORIGIN=http://localhost:4720
# Signs the session cookie. Unset = random per start (everyone is signed out on restart).
SESSION_SECRET=
# Where the trusted-IdP registry is stored (trusted-idps.json). Default .data; the image sets /data, so leave unset for compose.
# DATA_DIR=.data
# Set when behind a reverse proxy (e.g. 1) so secure cookies work.
TRUST_PROXY=

# --- PingFederate: issues ID-JAGs (pf-as mode), redeems them (pf-pf and byo->pingfederate) ---
PF_URL=https://pf.example.invalid
# Client that signs the user in (pi.flow at /api/id-jag-playground/issuer/pi-flow, code + PKCE, offline_access)
# and runs the token exchange for an ID-JAG (pf-as mode). Its redirect URI: ${APP_ORIGIN}/api/id-jag-playground/issuer/callback
PF_EXCHANGE_CLIENT_ID=
PF_EXCHANGE_CLIENT_SECRET=
# PingFederate's own certificate, when it is self-signed (pf-local writes it): PEM, trusted for PF_URL's origin only (never globally).
PF_CA_FILE=
# Client that redeems ID-JAGs at PF_URL (JWT bearer: the EXTENSION grant type).
PF_REDEEMER_CLIENT_ID=id-jag-redeemer
PF_REDEEMER_CLIENT_SECRET=
# resource sent with the JWT bearer grant at PF_URL. PF answers invalid_target unless an
# access token manager lists this resource in its selection settings.
PF_RESOURCE=

# --- SAML: the app signs an assertion for the signed-in user, PingFederate trades it for an ID-JAG (pf-as mode) ---
# pingfederate/configure-saml.js makes the key pair under deploy/local/saml/, the PingFederate objects, and PF_SAML_CLIENT_SECRET.
# Start with deploy/docker-compose.saml.yml: it mounts the key pair and sets the two file paths. npm runs: set them to those files.
SAML_SIGNING_KEY_FILE=
SAML_SIGNING_CERT_FILE=
# The assertion's Issuer (default ${APP_ORIGIN}/saml) and the Audience PingFederate's SAML token processor requires (default idJagKitSamlAud).
# SAML_ISSUER=
# SAML_AUDIENCE=idJagKitSamlAud
# The token-exchange client for the assertion (default id-jag-kit-saml) and its secret.
# PF_SAML_CLIENT_ID=id-jag-kit-saml
PF_SAML_CLIENT_SECRET=

# --- Acme PingFederate: an outside company's IdP, issues ID-JAGs addressed to PF_URL (pf-pf mode) ---
# The three ACME_* values come from the owner of the shared Acme PingFederate as a settings block:
#   npm run setup -- --mode=pf-pf --acme-settings=<file>      (merges them into ~/Development/.env, deletes the file, sets up the redeemer)
ACME_PF_URL=https://pf-acme.example.invalid
ACME_EXCHANGE_CLIENT_ID=
ACME_EXCHANGE_CLIENT_SECRET=

# --- Our resource authorization server (resource-as/) ---
# Its issuer: the ID-JAG aud. npm runs: http://localhost:9080 (compose: http://localhost:${AS_HOST_PORT}).
RESOURCE_AS_ISSUER=
# Where the server redeems. Defaults to ${RESOURCE_AS_ISSUER}/token (compose: http://resource-as:9080/token).
RESOURCE_AS_TOKEN_ENDPOINT=
# Our client at the resource AS. resource-as reads these same two and registers the client from them
# (the secret is hashed at start), so one .env serves both sides. Generate: openssl rand -hex 32
RESOURCE_AS_CLIENT_ID=id-jag-playground
RESOURCE_AS_CLIENT_SECRET=
# resource-as only: the most that client may ever be granted. Default "read mcp:invoke" (mcp-sample's scopes).
# RESOURCE_AS_CLIENT_SCOPE=read mcp:invoke

# --- The sample MCP server (mcp-sample/) ---
# Where the server calls MCP (step 4); /protected/profile is beside it. npm runs: http://localhost:9090/mcp
# (compose: http://mcp-sample:9090/mcp). Server-side only: mcp-sample sends no CORS headers.
MCP_URL=

# --- The ID-JAG request (pf-as mode) ---
# resource (the MCP server) and scope asked for in the exchange. The resource must equal mcp-sample's
# MCP_RESOURCE and be in resource-as ACCEPTED_RESOURCES (npm runs: http://localhost:9090/mcp;
# compose: http://localhost:${MCP_HOST_PORT}/mcp). Scope: leave empty to take what PingFederate grants.
ID_JAG_RESOURCE=
ID_JAG_SCOPE=

# --- App sign-in: OIDC at PingFederate (which federates to the kit's own PingOne environment) ---
# Defaults: OIDC_ISSUER=PF_URL, OIDC_CLIENT_ID/_SECRET=PF_EXCHANGE_CLIENT_ID/_SECRET. With those, one sign-in
# also serves the pf-as token exchange. No client at all = /auth/pi-flow/start answers 503 and nobody can register IdPs.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# client_secret_basic. Or leave it empty and set OIDC_PRIVATE_KEY_JWT (private_key_jwt).
OIDC_CLIENT_SECRET=
# PEM private key (\n escapes allowed) or a path to a PEM file; OIDC_PRIVATE_KEY_KID is its kid.
OIDC_PRIVATE_KEY_JWT=
OIDC_PRIVATE_KEY_KID=
# Defaults to ${APP_ORIGIN}/auth/callback. Register exactly this at PingFederate.
OIDC_REDIRECT_URI=
# Added to the fixed "openid profile email offline_access".
OIDC_EXTRA_SCOPES=
# Who may sign in: exact email domains (no subdomains). Plus-addresses and unverified emails are always refused.
ALLOWED_EMAIL_DOMAINS=pingidentity.com,pingone.com
# Admins: the ID token claim ADMIN_CLAIM contains ADMIN_CLAIM_VALUE, or the email is in ADMIN_EMAILS (comma-separated).
ADMIN_CLAIM=groups
ADMIN_CLAIM_VALUE=id-jag-admins
ADMIN_EMAILS=

# --- Account requests (/register, admin queue at /account-requests) ---
# Off until REGISTRATION_KEY is set (16+ characters; encrypts a requester's password until an admin decides; keep it stable).
# Approving a request adds the user to PingFederate's kit users, so the admin API must be reachable from this server
# (run pingfederate/configure-local-signin.js first). PF_ADMIN_INSECURE_TLS=true accepts PingFederate's self-signed admin certificate.
# Admin settings below go in this repo's .env or the shell, never the shared ~/Development/.env.
REGISTRATION_KEY=
PF_ADMIN_URL=
PF_ADMIN_USER=administrator
PF_ADMIN_PASSWORD=
PF_ADMIN_INSECURE_TLS=false

# --- xaa.dev (IdenX): a free outside IdP for the byo mode (docs/setup-guides.md, "Use xaa.dev") ---
# Works only with a public https RESOURCE_AS_ISSUER registered at xaa.dev; otherwise the button is off and says why.
# This app as a requesting app at https://xaa.dev/developer/register, redirect URI ${APP_ORIGIN}/api/id-jag-playground/xaa/callback
XAA_DEV_IDP_CLIENT_ID=
XAA_DEV_IDP_CLIENT_SECRET=
# The IdenX Trusted IdP entry's client at resource-as (idp-<id>, e.g. idp-xaa-dev) and the secret its owner fetched
# once on My IdPs. Sent only while the entry's client is this id.
XAA_DEV_RESOURCE_AS_CLIENT_ID=
XAA_DEV_RESOURCE_AS_CLIENT_SECRET=

# --- Trusted-IdP registry ---
# Bearer resource-as and pingfederate/sync-id-jag-trusted-idps.js send to read the registry. resource-as
# also learns to trust PF_URL from it (pf-as), so pf-as redemption needs it set for both.
# Unset = those reads answer 503. Generate one: openssl rand -hex 32
ID_JAG_REGISTRY_TOKEN=
# The resource AS's CLIENTS_FILE (a shared volume). Approving an IdP that targets the resource AS adds
# its idp-<id> client there (sha256 of the secret only). Unset = such approvals answer 409.
RESOURCE_AS_CLIENTS_FILE=
# Development only: let issuers and JWKS URLs on private or loopback addresses register and be fetched.
ALLOW_PRIVATE_ISSUERS=false

# resource-as and mcp-sample have more settings of their own (ISSUER, ACCEPTED_RESOURCES,
# TRUSTED_IDPS_REGISTRY_URL, AS_ISSUER, AS_JWKS_URL, MCP_RESOURCE, ...): see docs/resource-as.md.
# Compose sets them from the values above.

# Interop panel (pf-as mode, "Interop: other resource servers"). Client credentials for the targets that need one; the
# panel's Run button stays disabled for a target until both are set. motd needs none. Create the PingFederate side with
# pingfederate/configure-interop-targets.js; register the xaa.dev client by hand (docs/interop-lab.md).
INTEROP_AUTHPLANE_CLIENT_ID=
INTEROP_AUTHPLANE_CLIENT_SECRET=
INTEROP_XAA_CLIENT_ID=
INTEROP_XAA_CLIENT_SECRET=
# The kid workaround's PingFederate client (written by pingfederate/configure-kid-workaround.js): the panel's
# "Workaround" rows exchange as this client. Leave blank to keep those rows disabled.
INTEROP_KID_CLIENT_ID=
INTEROP_KID_CLIENT_SECRET=

# The hosted resource AS this server redeems at (optional; unset = a local `npm start -w resource-as` on :9080).
# If set, scripts/dev-live.sh uses it for the live run's leg 2 and the ID-JAG's resource:
# SE_RESOURCE_AS_ISSUER=https://<ras-host>.ping-demo.example.invalid/resource-as
# SE_ID_JAG_RESOURCE=https://<ras-host>.ping-demo.example.invalid/mcp

# Dual-homing via the family lab-proxy (https://local.ping-devops.com:8443/id-jag-kit/). Leave unset to serve
# the app only at APP_ORIGIN. PROXY_ORIGIN is the bare proxy origin (no path); PROXY_BASE the entry path.
# PROXY_ORIGIN=https://local.ping-devops.com:8443
# PROXY_BASE=/id-jag-kit
